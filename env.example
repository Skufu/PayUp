# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=postgres://payup:payup@localhost:5432/payup?sslmode=disable

# Gin Framework Mode (development/release)
GIN_MODE=release

# Auth
JWT_SECRET=change-me

# Optional token TTL overrides
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_HOURS=720

# CORS (comma-separated). Set this in production (Vercel -> Render).
# Example: CORS_ORIGINS=https://your-app.vercel.app,https://www.your-domain.com
# CORS_ORIGINS=

# Uploads (optional - enable Cloudinary for QR/proof image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend (optional - defaults to relative URLs for Vite proxy)
# VITE_API_BASE_URL=