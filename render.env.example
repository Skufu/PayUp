# ============================================
# PayUp Backend - Render Deployment .env
# ============================================
# Copy these values to Render dashboard
# Mark sensitive values as "Secret" in Render

# ============================================
# REQUIRED - Server Configuration
# ============================================
PORT=8080
GIN_MODE=release
LOG_LEVEL=INFO

# ============================================
# REQUIRED - Database
# ============================================
# PostgreSQL connection string from Neon/Supabase/Render Postgres
# Format: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=postgres://user:password@host:port/database?sslmode=require

# ============================================
# REQUIRED - Authentication
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-generate-secure-secret

# ============================================
# REQUIRED - CORS Configuration
# ============================================
# Comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app,https://www.your-domain.com
CORS_ORIGINS=https://your-app.vercel.app

# ============================================
# OPTIONAL - Token TTL Overrides
# ============================================
# Default: 15 minutes
ACCESS_TOKEN_TTL_MINUTES=15
# Default: 720 hours (30 days)
REFRESH_TOKEN_TTL_HOURS=720

# ============================================
# OPTIONAL - Google OAuth
# ============================================
# Get from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# OPTIONAL - Cloudinary Image Uploads
# ============================================
# Required for QR code and payment proof image uploads
# Get from Cloudinary dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# OPTIONAL - Push Notifications (VAPID)
# ============================================
# Generate with: go run backend/tools/generate-vapid.go
# VAPID_SUBJECT should be a mailto: URL (e.g., mailto:admin@example.com)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ============================================
# OPTIONAL - Database Connection Pool
# ============================================
# Default: 25
DB_MAX_CONNS=25




